[Unit]
Description=DriveGuard Security Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/driveguard-server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=driveguard
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
